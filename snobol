#!/bin/sh
# Launcher for the CREXX SNOBOL4 interpreter.
#   ./snobol [options] program.sno [program args]
#   ./snobol                       (no program: see README)
# The interpreter is compiled to bytecode on first use (about half a minute),
# afterwards it starts in under a second.  Set CREXX to the crexx driver if it
# is not on your PATH.
# The interpreter uses the CREXX Language Environment (CRE), included as the
# git submodule "cre" (https://github.com/mikebeer/language_environment).
DIR=$(cd "$(dirname "$0")" && pwd)
CREXX=${CREXX:-crexx}
CRESRC="$DIR/cre/src"
if [ ! -f "$CRESRC/cretext.crexx" ]; then
  echo "snobol: CRE not found - run: git submodule update --init" >&2
  exit 2
fi
CRELIBS=""
for m in crecond creio crenum cretext; do
  CRELIBS="$CRELIBS -l $CRESRC/$m.rxbin"
  if [ ! -f "$CRESRC/$m.rxbin" ] || [ "$CRESRC/$m.crexx" -nt "$CRESRC/$m.rxbin" ]; then
    "$CREXX" "$CRESRC/$m.crexx" -noexec >/dev/null 2>&1 || {
      echo "snobol: compilation of CRE module $m failed" >&2
      exit 2
    }
  fi
done
if [ ! -f "$DIR/snobol.rxbin" ] || [ "$DIR/snobol.crexx" -nt "$DIR/snobol.rxbin" ] || [ "$CRESRC/cretext.rxbin" -nt "$DIR/snobol.rxbin" ]; then
  echo "snobol: compiling interpreter (first run only)..." >&2
  "$CREXX" "$DIR/snobol.crexx" -i "$CRESRC" -noexec >/dev/null 2>&1 || {
    echo "snobol: compilation failed - run: $CREXX $DIR/snobol.crexx -i $CRESRC -noexec" >&2
    exit 2
  }
fi
exec "$CREXX" "$DIR/snobol.crexx" -nocompile $CRELIBS -args "$@"
